# Copiar a .env.local (ya está en .gitignore vía *.local) y completar con
# los valores del proyecto en Supabase (Settings -> API Keys).
#
# Esta es la clave "anon" / "publishable" -- es pública a propósito, se usa
# desde el navegador y queda protegida por las políticas de RLS de cada
# tabla. NUNCA poner acá la service_role/secret key.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Opcional: "staging" muestra la franja roja "DEV" en la esquina (para no
# confundir el entorno con producción). En Vercel se carga como env var con
# target "Preview" únicamente -- ver CLAUDE.md, sección "Entornos". Corriendo
# local con `npm run dev` la franja aparece sola, no hace falta setear esto.
VITE_APP_ENV=
