# Copiar a .env.local (ya está en .gitignore vía *.local) y completar con
# los valores del proyecto en Supabase (Settings -> API Keys).
#
# Esta es la clave "anon" / "publishable" -- es pública a propósito, se usa
# desde el navegador y queda protegida por las políticas de RLS de cada
# tabla. NUNCA poner acá la service_role/secret key.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
